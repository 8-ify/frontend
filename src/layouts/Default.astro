---
const { pageMeta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageMeta.title}</title>
    {pageMeta.meta && pageMeta.meta.map((metaObj: any) => <meta {...metaObj} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <slot />
    <!-- <script>
      import("@logic/client/main.js").then((f) => f.default());
    </script> -->
  </body>
</html>

<style is:global>
    :root {
        --primary: #E68D3E;
        --secondary: #FFEA63;
        --primary-explore: #3973AD;
        --secondary-explore: #2C488F;
        --tertiary-explore: #CDF1F4;
        --primary-create: #B3508D;
        --secondary-create: #6D2975;
        --background-color: #1E1E1E;
        --text-color: #FFFFFF;
    }

    /* Add fonts from /font/*.ttf */
    @font-face {
        font-family: "PressStart2P";
        src: url("/fonts/PressStart2P.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
    }

    @font-face {
        font-family: "04B";
        src: url("/fonts/04B_30.ttf") format("truetype");
        font-weight: normal;
        font-style: normal;
    }

    body {
        margin: 0;
        font-family: "PressStart2P", "04B", sans-serif;
        background-color: var(--background-color);
        color: var(--text-color);
    }

    h1, h2, h3, h4, h5, h6 {
        margin: 0;
        font-family: "04B", "PressStart2P", sans-serif;
    }

    a {
        text-decoration: none;
        color: inherit;
    }
</style>