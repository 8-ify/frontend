---
import DefaultLayout from "../../layouts/Default.astro";
import HeaderContainer from "../../components/HeaderContainer.astro";
---

<DefaultLayout pageMeta={{ title: "Explore assets — 8-ify" }}>
	<HeaderContainer headerTitle="EXPLORE" styleClass="explore" />
	<div class="filter-links">
		<a href="/explore">8-u page</a>
		<a href="/explore/collection" class="selected">ur collection</a>
        <a href="/explore/categories">categories</a>
	</div>
    <div class="content-masonry">
        <!-- Mock to replace content -->
        <div class="masonry-item" style="height: 320px;">Item 1</div>
        <div class="masonry-item" style="height: 740px;">Item 2</div>
        <div class="masonry-item" style="height: 280px;">Item 3</div>
        <div class="masonry-item" style="height: 400px;">Item 4</div>
        <div class="masonry-item" style="height: 260px;">Item 5</div>
        <div class="masonry-item" style="height: 180px;">Item 6</div>
        <div class="masonry-item" style="height: 300px;">Item 7</div>
        <div class="masonry-item" style="height: 660px;">Item 8</div>
        <div class="masonry-item" style="height: 280px;">Item 9</div>
        <div class="masonry-item" style="height: 500px;">Item 10</div>
    </div>
</DefaultLayout>

<style>
    div.filter-links {
        display: flex;
        gap: 2rem;
        justify-content: left;
        margin-top: 2rem;
        margin-left: 2rem;
    }

    .filter-links a {
        font-size: 2rem;
        color: var(--tertiary-explore);
    }

    .filter-links a.selected {
        font-weight: bold;
        color: var(--primary-explore);
    }

    .content-masonry {
        column-count: 4;
        column-gap: 1rem;
        margin: 2rem;
    }

    .masonry-item {
        background-color: var(--secondary-explore);
        margin-bottom: 1rem;
        padding: 1rem;
        break-inside: avoid;
        color: white;
        font-size: 1.5rem;
        text-align: center;
    }
</style>