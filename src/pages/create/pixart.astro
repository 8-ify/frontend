---
import DefaultLayout from "../../layouts/Default.astro";
import HeaderContainer from "../../components/HeaderContainer.astro";
---

<DefaultLayout pageMeta={{ title: "Create assets — 8-ify" }}>
	<HeaderContainer headerTitle="CREATE" styleClass="create" />
	<div class="filter-links">
		<a href="/create">8-bit Music</a>
		<a href="/create/pixart" class="selected">Pixel Art</a>
	</div>
    <pixart-upload />
</DefaultLayout>

<style>
    div.filter-links {
        display: flex;
        gap: 2rem;
        justify-content: left;
        margin-top: 2rem;
        margin-left: 2rem;
    }

    .filter-links a {
        font-size: 2rem;
        color: var(--tertiary-create);
    }

    .filter-links a.selected {
        font-weight: bold;
        color: var(--primary-create);
    }
</style>

<script>
    import('../../components/UploadWidget.js');
    import('../../components/PixArtUpload.js');
</script>