---
import DefaultLayout from "../../layouts/Default.astro";
import HeaderContainer from "../../components/HeaderContainer.astro";
---

<DefaultLayout pageMeta={{ title: "Explore assets — 8-ify" }}>
	<HeaderContainer headerTitle="EXPLORE" styleClass="explore" />
	<div class="filter-links">
		<a href="/explore">8-u page</a>
		<a href="/explore/collection" class="selected">ur collection</a>
        <a href="/explore/categories">categories</a>
	</div>
    <asset-grid />
</DefaultLayout>

<style>
    div.filter-links {
        display: flex;
        gap: 2rem;
        justify-content: left;
        margin-top: 2rem;
        margin-left: 2rem;
    }

    .filter-links a {
        font-size: 2rem;
        color: var(--tertiary-explore);
    }

    .filter-links a.selected {
        font-weight: bold;
        color: var(--primary-explore);
    }
</style>

<script>
    import('../../components/AssetTile.js');
    import('../../components/AssetGrid.js');
</script>